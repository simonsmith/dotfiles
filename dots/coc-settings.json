{
  "coc.preferences.colorSupport": false,
  "coc.preferences.formatOnType": true,

  "codeLens.enable": true,
  "codeLens.position": "eol",

  "diagnostic.checkCurrentLine": true,
  "diagnostic.errorSign": "●",
  "diagnostic.warningSign": "▲",
  "diagnostic.infoSign": "●",
  "diagnostic.hintSign": "◆",

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": false,
    "source.fixAll.stylelint": false
  },

  "floatFactory.floatConfig": {
    "border": true,
    "rounded": true,
    "maxWidth": 90,
    "maxHeight": 20
  },

  "inlayHint.maximumLength": 80,
  "inlayHint.refreshOnInsertMode": false,

  "suggest.maxCompleteItemCount": 30,
  "suggest.formatItems": ["abbr", "menu"],
  "suggest.floatConfig": {
    "border": true,
    "rounded": true,
    "maxWidth": 80,
    "maxHeight": 16
  },
  "suggest.minTriggerInputLength": 1,
  "suggest.noselect": false,
  "suggest.pumheight": 12,
  "suggest.pumFloatConfig": {
    "border": true,
    "rounded": true
  },
  "suggest.timeout": 3000,

  "intelephense.codeLens.implementations.enable": true,
  "intelephense.codeLens.references.enable": false,
  "intelephense.environment.phpVersion": "8.5.0",
  "intelephense.inlayHint.parameterNames": false,
  "intelephense.inlayHint.parameterTypes": true,
  "intelephense.inlayHint.returnTypes": true,

  "phpstan.memoryLimit": "2G",
  "phpstan.download.checkOnStartup": false,

  "css.lint.unknownAtRules": "ignore",
  "eslint.enable": true,
  "eslint.filetypes": [
    "javascript",
    "javascript.jsx",
    "typescript",
    "typescriptreact",
    "javascriptreact"
  ],
  "eslint.onIgnoredFiles": "off",
  "eslint.options": {
    "cache": true,
    "cacheLocation": ".eslintcache"
  },
  "eslint.run": "onSave",
  "eslint.workingDirectories": ["."],
  "stylelintplus.autoFixOnSave": false,
  "stylelintplus.enable": true,
  "stylelintplus.filetypes": ["css", "scss", "sass", "less", "postcss"],

  "javascript.preferences.noSemanticsValidation": false,
  "javascript.preferences.noSuggestionDiagnostics": true,
  "javascript.referencesCodeLens.enable": false,
  "javascript.suggestionActions.enabled": false,
  "javascript.validate.enable": false,

  "tsserver.maxTsServerMemory": 8192,
  "tsserver.useLocalTsdk": true,
  "tsserver.useSeparateSyntaxServer": false,
  "tsserver.watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "**/.git",
      "**/dist",
      "**/build",
      "**/cypress",
      "**/.next",
      "**/coverage",
      "**/.nyc_output",
      "**/tmp",
      "**/temp"
    ]
  },
  "typescript.preferences.lazyConfiguredProjectsFromExternalProject": true,
  "typescript.preferences.noSemanticsValidation": false,
  "typescript.preferences.noSuggestionDiagnostics": true,
  "typescript.referencesCodeLens.enable": false,
  "typescript.suggestionActions.enabled": false,
  "typescript.surveys.enabled": false,

  "vue.codeLens.enabled": false,

  "java.autobuild.enabled": false,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/target/**",
    "**/build/**",
    "**/dist/**"
  ],
  "java.inlayHints.parameterNames.enabled": "none",
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable",
  "java.maxConcurrentBuilds": 1
}
